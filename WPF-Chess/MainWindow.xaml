<Window x:Class="WPF_Chess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Chess"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="600" Width="1000">
    <Grid>
        <Grid Width="400" Height="400">
            <Grid x:Name="GameBackground">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <Rectangle Grid.Column="0" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Column="1" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Column="2" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Column="3" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Column="4" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Column="5" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Column="6" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Column="7" Fill="LightGray" Opacity=".2"/>

                <Rectangle Grid.Row="1" Grid.Column="0" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="1" Grid.Column="1" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="1" Grid.Column="2" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="1" Grid.Column="3" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="1" Grid.Column="4" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="1" Grid.Column="5" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="1" Grid.Column="6" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="1" Grid.Column="7" Fill="LightGray" Opacity=".6"/>

                <Rectangle Grid.Row="2" Grid.Column="0" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="2" Grid.Column="1" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="2" Grid.Column="2" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="2" Grid.Column="3" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="2" Grid.Column="4" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="2" Grid.Column="5" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="2" Grid.Column="6" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="2" Grid.Column="7" Fill="LightGray" Opacity=".2"/>

                <Rectangle Grid.Row="3" Grid.Column="0" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="3" Grid.Column="1" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="3" Grid.Column="2" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="3" Grid.Column="3" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="3" Grid.Column="4" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="3" Grid.Column="5" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="3" Grid.Column="6" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="3" Grid.Column="7" Fill="LightGray" Opacity=".6"/>

                <Rectangle Grid.Row="4" Grid.Column="0" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="4" Grid.Column="1" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="4" Grid.Column="2" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="4" Grid.Column="3" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="4" Grid.Column="4" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="4" Grid.Column="5" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="4" Grid.Column="6" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="4" Grid.Column="7" Fill="LightGray" Opacity=".2"/>

                <Rectangle Grid.Row="5" Grid.Column="0" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="5" Grid.Column="1" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="5" Grid.Column="2" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="5" Grid.Column="3" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="5" Grid.Column="4" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="5" Grid.Column="5" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="5" Grid.Column="6" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="5" Grid.Column="7" Fill="LightGray" Opacity=".6"/>

                <Rectangle Grid.Row="6" Grid.Column="0" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="6" Grid.Column="1" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="6" Grid.Column="2" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="6" Grid.Column="3" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="6" Grid.Column="4" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="6" Grid.Column="5" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="6" Grid.Column="6" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="6" Grid.Column="7" Fill="LightGray" Opacity=".2"/>

                <Rectangle Grid.Row="7" Grid.Column="0" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="7" Grid.Column="1" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="7" Grid.Column="2" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="7" Grid.Column="3" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="7" Grid.Column="4" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="7" Grid.Column="5" Fill="LightGray" Opacity=".6"/>
                <Rectangle Grid.Row="7" Grid.Column="6" Fill="LightGray" Opacity=".2"/>
                <Rectangle Grid.Row="7" Grid.Column="7" Fill="LightGray" Opacity=".6"/>
            </Grid>
            <Grid x:Name="GameForeground">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Column_A"/>
                    <ColumnDefinition x:Name="Column_B"/>
                    <ColumnDefinition x:Name="Column_C"/>
                    <ColumnDefinition x:Name="Column_D"/>
                    <ColumnDefinition x:Name="Column_E"/>
                    <ColumnDefinition x:Name="Column_F"/>
                    <ColumnDefinition x:Name="Column_G"/>
                    <ColumnDefinition x:Name="Column_H"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="Row_8"/>
                    <RowDefinition x:Name="Row_7"/>
                    <RowDefinition x:Name="Row_6"/>
                    <RowDefinition x:Name="Row_5"/>
                    <RowDefinition x:Name="Row_4"/>
                    <RowDefinition x:Name="Row_3"/>
                    <RowDefinition x:Name="Row_2"/>
                    <RowDefinition x:Name="Row_1"/>
                </Grid.RowDefinitions>

                <Border x:Name="A8" Grid.Column="0"/>
                <Border x:Name="B8" Grid.Column="1"/>
                <Border x:Name="C8" Grid.Column="2"/>
                <Border x:Name="D8" Grid.Column="3"/>
                <Border x:Name="E8" Grid.Column="4"/>
                <Border x:Name="F8" Grid.Column="5"/>
                <Border x:Name="G8" Grid.Column="6"/>
                <Border x:Name="H8" Grid.Column="7"/>

                <Border x:Name="A7" Grid.Row="1" Grid.Column="0"/>
                <Border x:Name="B7" Grid.Row="1" Grid.Column="1"/>
                <Border x:Name="C7" Grid.Row="1" Grid.Column="2"/>
                <Border x:Name="D7" Grid.Row="1" Grid.Column="3"/>
                <Border x:Name="E7" Grid.Row="1" Grid.Column="4"/>
                <Border x:Name="F7" Grid.Row="1" Grid.Column="5"/>
                <Border x:Name="G7" Grid.Row="1" Grid.Column="6"/>
                <Border x:Name="H7" Grid.Row="1" Grid.Column="7"/>

                <Border x:Name="A6" Grid.Row="2" Grid.Column="0"/>
                <Border x:Name="B6" Grid.Row="2" Grid.Column="1"/>
                <Border x:Name="C6" Grid.Row="2" Grid.Column="2"/>
                <Border x:Name="D6" Grid.Row="2" Grid.Column="3"/>
                <Border x:Name="E6" Grid.Row="2" Grid.Column="4"/>
                <Border x:Name="F6" Grid.Row="2" Grid.Column="5"/>
                <Border x:Name="G6" Grid.Row="2" Grid.Column="6"/>
                <Border x:Name="H6" Grid.Row="2" Grid.Column="7"/>

                <Border x:Name="A5" Grid.Row="3" Grid.Column="0"/>
                <Border x:Name="B5" Grid.Row="3" Grid.Column="1"/>
                <Border x:Name="C5" Grid.Row="3" Grid.Column="2"/>
                <Border x:Name="D5" Grid.Row="3" Grid.Column="3"/>
                <Border x:Name="E5" Grid.Row="3" Grid.Column="4"/>
                <Border x:Name="F5" Grid.Row="3" Grid.Column="5"/>
                <Border x:Name="G5" Grid.Row="3" Grid.Column="6"/>
                <Border x:Name="H5" Grid.Row="3" Grid.Column="7"/>

                <Border x:Name="A4" Grid.Row="4" Grid.Column="0"/>
                <Border x:Name="B4" Grid.Row="4" Grid.Column="1"/>
                <Border x:Name="C4" Grid.Row="4" Grid.Column="2"/>
                <Border x:Name="D4" Grid.Row="4" Grid.Column="3"/>
                <Border x:Name="E4" Grid.Row="4" Grid.Column="4"/>
                <Border x:Name="F4" Grid.Row="4" Grid.Column="5"/>
                <Border x:Name="G4" Grid.Row="4" Grid.Column="6"/>
                <Border x:Name="H4" Grid.Row="4" Grid.Column="7"/>

                <Border x:Name="A3" Grid.Row="5" Grid.Column="0"/>
                <Border x:Name="B3" Grid.Row="5" Grid.Column="1"/>
                <Border x:Name="C3" Grid.Row="5" Grid.Column="2"/>
                <Border x:Name="D3" Grid.Row="5" Grid.Column="3"/>
                <Border x:Name="E3" Grid.Row="5" Grid.Column="4"/>
                <Border x:Name="F3" Grid.Row="5" Grid.Column="5"/>
                <Border x:Name="G3" Grid.Row="5" Grid.Column="6"/>
                <Border x:Name="H3" Grid.Row="5" Grid.Column="7"/>

                <Border x:Name="A2" Grid.Row="6" Grid.Column="0"/>
                <Border x:Name="B2" Grid.Row="6" Grid.Column="1"/>
                <Border x:Name="C2" Grid.Row="6" Grid.Column="2"/>
                <Border x:Name="D2" Grid.Row="6" Grid.Column="3"/>
                <Border x:Name="E2" Grid.Row="6" Grid.Column="4"/>
                <Border x:Name="F2" Grid.Row="6" Grid.Column="5"/>
                <Border x:Name="G2" Grid.Row="6" Grid.Column="6"/>
                <Border x:Name="H2" Grid.Row="6" Grid.Column="7"/>

                <Border x:Name="A1" Grid.Row="7" Grid.Column="0"/>
                <Border x:Name="B1" Grid.Row="7" Grid.Column="1"/>
                <Border x:Name="C1" Grid.Row="7" Grid.Column="2"/>
                <Border x:Name="D1" Grid.Row="7" Grid.Column="3"/>
                <Border x:Name="E1" Grid.Row="7" Grid.Column="4"/>
                <Border x:Name="F1" Grid.Row="7" Grid.Column="5"/>
                <Border x:Name="G1" Grid.Row="7" Grid.Column="6"/>
                <Border x:Name="H1" Grid.Row="7" Grid.Column="7"/>
            </Grid>
            <Rectangle Stroke="Gray" Fill="Transparent"/>
        </Grid>
        <Grid Width="400" Height="30" VerticalAlignment="Top" Margin="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="A" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="1" Text="B" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="2" Text="C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="3" Text="D" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="4" Text="E" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="5" Text="F" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="6" Text="G" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Column="7" Text="H" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        </Grid>
        <Grid Height="400" Width="30" HorizontalAlignment="Left" Margin="260 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="1" Text="7" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="2" Text="6" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="3" Text="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="4" Text="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="5" Text="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="6" Text="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Grid.Row="7" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        </Grid>
    </Grid>
</Window>
